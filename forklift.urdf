    </collision>
    <inertial>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="4.5208333333333325e-05" ixy="0.0" ixz="0.0" iyy="8e-05" iyz="0.0" izz="4.5208333333333325e-05"/>
    </inertial>
  </link>
  <!-- Wheel Joint -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin rpy="0 0 0" xyz="0.1 0.15 0.0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.2"/>
  </joint>
  <!-- Gazebo Simulation Properties -->
  <gazebo reference="left_wheel_link">
    <material>Gazebo/Black</material>
    <mu>5.0</mu>
  </gazebo>
  <!-- Wheel Link -->
  <link name="right_wheel_link">
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://forklift_description/meshes/wheel.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
