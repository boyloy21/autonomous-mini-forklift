  </link>
  <!-- Wheel Joint -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin rpy="0 0 0" xyz="0.1 -0.15 0.0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.2"/>
  </joint>
  <!-- Gazebo Simulation Properties -->
  <gazebo reference="right_wheel_link">
    <material>Gazebo/Black</material>
    <mu>5.0</mu>
  </gazebo>
  <link name="lift_link">
    <visual>
      <origin rpy="0 0 3.14159" xyz="-0.59 -0.045 0.15"/>
      <geometry>
        <mesh filename="package://forklift_description/meshes/fork.stl" scale="0.002 0.001 0.001"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin rpy="0 0 3.14159" xyz="-0.59 -0.045 0.15"/>
