      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0024897816666666667" ixy="0" ixz="0" iyy="0.0037874999999999996" iyz="0" izz="0.006202281666666667"/>
    </inertial>
  </link>
  <joint name="lift_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="lift_link"/>
    <origin rpy="0 0 0" xyz="0.1525 0.0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="500" lower="0.0" upper="0.15" velocity="0.1"/>
    <dynamics damping="5.0" friction="1.0"/>
  </joint>
  <gazebo reference="lift_link">
    <material>Gazebo/Yellow</material>
    <mu1>10.0</mu1>
    <mu2>10.0</mu2>
    <kp>1000000</kp>
    <kd>10</kd>
    <max_contacts>20</max_contacts>
  </gazebo>
  <transmission name="left_wheel_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_wheel_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="right_wheel_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_wheel_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="lift_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="lift_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="lift_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
