<?xml version="1.0"?>
<model>
  <name>battery_charger_station</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>

  <author>
    <name>forklift_gazebo</name>
    <email>user@example.com</email>
  </author>

  <description>
    Static docking / battery-charging station for the mini forklift AMR.
    The front face carries a printed ArUco marker (DICT_4X4_100, id=4)
    used by the robot's camera to visually servo into the dock. A small
    contact pad + contact sensor mark the point at which the robot is
    considered "docked" so an external node can call the LinearBatteryPlugin
    recharge service on the robot model.
  </description>
</model>
