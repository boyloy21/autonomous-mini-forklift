<?xml version="1.0"?>
<model>
  <name>Mini Pallet</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>
  <author>
    <name>Mini Forklift AMR project</name>
  </author>
  <description>
    Miniature pallet prop (120mm x 100mm x 14mm), scaled to match the Mini
    Forklift AMR testbed (fork travel ~150mm, wheel radius 40mm). Built from
    3 bottom stringers + 4 top deck boards, same silhouette as a real pallet.
  </description>
</model>
