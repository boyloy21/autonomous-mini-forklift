<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='pallet_box_mobile'>

    <pose>0 0.1 0.005 0 0 0</pose>
    <self_collide>false</self_collide>

    <link name='pallet_base'>
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.25 0 0 0</pose>
        <!-- mass unchanged (0.19kg); inertia recomputed as a solid-box
             approximation for the new, taller overall bounding box
             (0.35 x 0.23 x ~0.38m), same mass -->
        <mass>0.19</mass>
        <inertia>
          <ixx>0.003094</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.004196</iyy>
          <iyz>0</iyz>
          <izz>0.002777</izz>
        </inertia>
      </inertial>



      <collision name="pallet_center_collision">
        <pose>0 0 0.0275 0 0 0</pose>
        <geometry>
          <box>
            <size>0.35 0.029 0.079</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.4</mu>
              <mu2>0.4</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <collision name="pallet_left_collision">
        <pose>0 -0.100 0.0275 0 0 0</pose>
        <geometry>
          <box>
            <size>0.35 0.02 0.079</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.4</mu>
              <mu2>0.4</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <collision name="pallet_right_collision">
        <pose>0 0.100 0.0275 0 0 0</pose>
        <geometry>
          <box>
            <size>0.35 0.02 0.079</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.4</mu>
              <mu2>0.4</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <collision name="pallet_top_collision">
        <pose>0 0 0.0848 0 0 0</pose>
        <geometry>
          <box>
            <size>0.35 0.28 0.0115</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.4</mu>
              <mu2>0.4</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      

      

      
      


      <!-- <collision name="boxes_collision">
        <pose>0 0 0.234 0 0 0</pose>
        <geometry>
          <box>
            <size>0.35 0.23 0.287</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.4</mu>
              <mu2>0.4</mu2>
            </ode>
          </friction>
        </surface>
      </collision>  -->


      <visual name='pallet_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.287 0.287 0.623</scale>
            <uri>meshes/pallet.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name='boxes_visual'>
        <pose>-0.0155 0 0.05 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.2 0.2 0.1</scale>
            <uri>meshes/boxes.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name='aruco_marker_visual'>
        <pose>0.184 0 0.03 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.029 0.029 0.029</scale>
            <uri>meshes/marker_box.dae</uri>
          </mesh>
        </geometry>
      </visual>

    </link>
    <plugin filename="ignition-gazebo-pose-publisher-system" name="ignition::gazebo::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <update_frequency>20</update_frequency>
    </plugin>
    <static>0</static>
  </model>
</sdf>