<?xml version="1.0" ?>
<sdf version='1.9'>
  <model name='forklift'>
    <pose>0 0 0 0 0 0</pose>

    <link name="base_footprint"/>

    <link name='base_link'>
      <pose relative_to='base_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>-0.003608695652173913 0 0.0505072463768116 0 0 0</pose>
        <mass>3.4500000000000002</mass>
        <inertia>
          <ixx>0.029111552318840571</ixx>
          <ixy>0</ixy>
          <ixz>-0.00015806521739130441</ixz>
          <iyy>0.030121534057971008</iyy>
          <iyz>0</iyz>
          <izz>0.03058636173913044</izz>
        </inertia>
      </inertial>

      <!-- Box centred on the body mesh's actual extent (x -0.108..0.137,
           y -0.123..0.120, z 0.029..0.212 in base_link). It previously
           reused the mesh's origin offset, which put the box ~16 cm behind
           the visible body, so rear contact happened in thin air. -->
      <collision name='base_link_collision'>
        <pose>0.0145 -0.0015 0.1205 0 0 0</pose>
        <geometry>
          <box>
            <size>0.245 0.2426 0.18</size>
          </box>
        </geometry>
      </collision>

      <visual name='base_link_visual'>
        <pose>-0.15 -0.045 0.19 0 0 3.14159</pose>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>package://forklift_gazebo/models/mini_forklift/meshes/mini_forklift_base.stl</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1 1 0 1</diffuse>
          <ambient>1 1 0 1</ambient>
        </material>
      </visual>
    </link>

    <joint name="base_joint" type="fixed">
      <pose relative_to='base_footprint'>0 0 0.04 0 0 0</pose>
      <parent>base_footprint</parent>
      <child>base_link</child>
    </joint>

    <link name="front_caster">
      <pose relative_to='caster_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>1.5e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.5e-05</iyy>
          <iyz>0</iyz>
          <izz>1.5e-05</izz>
        </inertia>
      </inertial>
      <collision name='front_caster_collision'>
        <pose>-0.0 0 0.0 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.029999999999999999</radius>
          </sphere>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode>
              <mu>0.10000000000000001</mu>
              <mu2>0.10000000000000001</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='front_caster_visual'>
        <pose>-0.00 0 -0.00 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.029999999999999999</radius>
          </sphere>
        </geometry>
        <material>
          <diffuse>0 0 1 1</diffuse>
          <ambient>0 0 1 1</ambient>
        </material>
      </visual>
    </link>

    <joint name="caster_joint" type="fixed">
      <pose relative_to='base_link'>-0.06 0 0.03 0 0 0</pose>
      <parent>base_link</parent>
      <child>front_caster</child>
    </joint>


    <link name='imu_link'>
      <pose relative_to='imu_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>1.5e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.5e-05</iyy>
          <iyz>0</iyz>
          <izz>1.5e-05</izz>
        </inertia>
      </inertial>
      <collision name='imu_link_collision'>
        <geometry>
          <box>
            <size>0.03 0.03 0.03</size>
          </box>
        </geometry>
      </collision>
      <visual name='imu_link_visual'>
        <geometry>
          <box>
            <size>0.03 0.03 0.03</size>
          </box>
        </geometry>
        <material>
          <diffuse>0 0 0 1</diffuse>
          <ambient>0 0 0 1</ambient>
        </material>
      </visual>
      <sensor name='imu_sensor' type='imu'>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
        <topic>$(arg namespace)/imu</topic>
        <imu>
          <angular_velocity>
            <x>
              <noise type='gaussian'>
                <mean>0</mean>
                <stddev>0.00020000000000000001</stddev>
                <bias_mean>7.5000000000000002e-06</bias_mean>
                <bias_stddev>7.9999999999999996e-07</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type='gaussian'>
                <mean>0</mean>
                <stddev>0.00020000000000000001</stddev>
                <bias_mean>7.5000000000000002e-06</bias_mean>
                <bias_stddev>7.9999999999999996e-07</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type='gaussian'>
                <mean>0</mean>
                <stddev>0.00020000000000000001</stddev>
                <bias_mean>7.5000000000000002e-06</bias_mean>
                <bias_stddev>7.9999999999999996e-07</bias_stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type='gaussian'>
                <mean>0</mean>
                <stddev>0.017000000000000001</stddev>
                <bias_mean>0.10000000000000001</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type='gaussian'>
                <mean>0</mean>
                <stddev>0.017000000000000001</stddev>
                <bias_mean>0.10000000000000001</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type='gaussian'>
                <mean>0</mean>
                <stddev>0.017000000000000001</stddev>
                <bias_mean>0.10000000000000001</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>

        <ignition_frame_id>imu_link</ignition_frame_id>
      </sensor>
    </link>
    <joint name='imu_joint' type='fixed'>
      <pose relative_to='base_link'>0 0 0.14 0 0 0</pose>
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>


    <link name='lidar_link'>
      <pose relative_to='lidar_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0.007 0 0.025 0 0 0</pose>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.000058</ixx>
          <ixy>0</ixy>
          <ixz>0.000005</ixz>
          <iyy>0.000099</iyy>
          <iyz>0</iyz>
          <izz>0.000103</izz>
        </inertia>
      </inertial>
      <collision name='lidar_link_collision'>
        <geometry>
          <cylinder>
            <length>0.044999999999999998</length>
            <radius>0.044999999999999998</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name='lidar_link_visual'>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>package://forklift_gazebo/models/mini_forklift/meshes/ydlidar_x2_assy.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <sensor name='lidar' type='gpu_lidar'>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>30</update_rate>
        <topic>$(arg namespace)/scan</topic>

        <ignition_frame_id>lidar_link</ignition_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>6.2831853071795862</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.20000000000000001</min>
            <max>7</max>
            <resolution>0.014999999999999999</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>
    <joint name='lidar_joint' type='fixed'>
      <pose relative_to='base_link'>-0.01 0 0.2 0 0 0</pose>
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <joint name='left_wheel_joint' type='revolute'>
      <pose relative_to='base_link'>0.1 0.15 0.04 0 0 0</pose>
      <parent>base_link</parent>
      <child>left_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-10000000000000000</lower>
          <upper>10000000000000000</upper>
        </limit>
        <dynamics>
          <damping>0.20000000000000001</damping>
          <friction>0</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='left_wheel_link'>
      <pose relative_to='left_wheel_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 1.570796326794896 0 0</pose>
        <mass>0.10000000000000001</mass>
        <inertia>
          <ixx>4.5208333333333332e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>8.0000000000000007e-05</iyy>
          <iyz>0</iyz>
          <izz>4.5208333333333332e-05</izz>
        </inertia>
      </inertial>
      <collision name='left_wheel_link_collision'>
        <pose>0 0 0 1.570796326794896 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.025000000000000001</length>
            <radius>0.040000000000000001</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name='left_wheel_link_visual'>
        <pose>0 0 0 1.570796326794896 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>package://forklift_gazebo/models/mini_forklift/meshes/wheel.stl</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Black</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
          <diffuse>0 0 0 1</diffuse>
          <ambient>0 0 0 1</ambient>
        </material>
      </visual>
      <mu>5.0</mu>
    </link>

    <joint name='lift_joint' type='prismatic'>
      <pose relative_to='base_link'>0.1525 0 0.04 0 0 0</pose>
      <parent>base_link</parent>
      <child>lift_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.14999999999999999</upper>
          <effort>500</effort>
          <velocity>0.10000000000000001</velocity>
        </limit>
        <dynamics>
          <damping>5</damping>
          <friction>1</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='lift_link'>
      <pose relative_to='lift_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0.001363636363636364 0 0.001181818181818182 0 0 0</pose>
        <mass>0.55000000000000004</mass>
        <inertia>
          <ixx>0.0025024634848484851</ixx>
          <ixy>0</ixy>
          <ixz>-9.8636363636363638e-06</ixz>
          <iyy>0.0038094090909090912</iyy>
          <iyz>0</iyz>
          <izz>0.00621550893939394</izz>
        </inertia>
      </inertial>
     
      <collision name='lift_link_collision'>
        <pose>-0.59 -0.045 0.15 0 0 3.14159</pose>
        <geometry>
          <mesh>
            <scale>0.002 0.001 0.001</scale>
            <uri>package://forklift_gazebo/models/mini_forklift/meshes/fork.stl</uri>
          </mesh>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>1000000</kp>
              <kd>10</kd>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>10</mu>
              <mu2>10</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='lift_link_visual'>
        <pose>-0.59 -0.045 0.15 0 0 3.14159</pose>
        <geometry>
          <mesh>
            <scale>0.002 0.001 0.001</scale>
            <uri>package://forklift_gazebo/models/mini_forklift/meshes/fork.stl</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Yellow</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
          <diffuse>1 0 0 1</diffuse>
          <ambient>1 0 0 1</ambient>
        </material>
      </visual>
      <max_contacts>20</max_contacts>
    </link>


    <link name='camera_link'>
      <pose relative_to='camera_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0.005 0 0.013 0 0 0</pose>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.000005</ixx>
          <ixy>0</ixy>
          <ixz>-0.000001</ixz>
          <iyy>0.000004</iyy>
          <iyz>0</iyz>
          <izz>0.000003</izz>
        </inertia>
      </inertial>
      <collision name='camera_link_collision'>
        <geometry>
          <box>
            <size>0.022 0.022 0.022</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name='camera_link_visual'>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>package://forklift_gazebo/models/mini_forklift/meshes/front_camera.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <sensor name='camera' type='rgbd_camera'>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>30</update_rate>
        <topic>$(arg namespace)/camera</topic>
        <camera name='camera'>
          <pose>0 0 0 0 0.0 0</pose>
          <horizontal_fov>1.0800000000000001</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.050000000000000003</near>
            <far>5</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
          <baseline>0.2</baseline>
          <pointCloudCutoff>0.5</pointCloudCutoff>
          <pointCloudCutoffMax>3.0</pointCloudCutoffMax>
          <distortionK1>0</distortionK1>
          <distortionK2>0</distortionK2>
          <distortionK3>0</distortionK3>
          <distortionT1>0</distortionT1>
          <distortionT2>0</distortionT2>
          <CxPrime>0</CxPrime>
          <Cx>0</Cx>
          <Cy>0</Cy>
          <focalLength>0</focalLength>
          <hackBaseline>0</hackBaseline>
        </camera>
        <ignition_frame_id>camera_link</ignition_frame_id>
        <camera_info_topic>$(arg namespace)/camera_info</camera_info_topic>
      </sensor>
    </link>
    <joint name='camera_joint' type='fixed'>
      <pose relative_to='lift_link'>0.01 0 0 0 0 0</pose>
      <parent>lift_link</parent>
      <child>camera_link</child>
    </joint>

    <joint name='right_wheel_joint' type='revolute'>
      <pose relative_to='base_link'>0.1 -0.15 0.04 0 0 0</pose>
      <parent>base_link</parent>
      <child>right_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-10000000000000000</lower>
          <upper>10000000000000000</upper>
        </limit>
        <dynamics>
          <damping>0.20000000000000001</damping>
          <friction>0</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='right_wheel_link'>
      <pose relative_to='right_wheel_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 1.570796326794896 0 0</pose>
        <mass>0.10000000000000001</mass>
        <inertia>
          <ixx>4.5208333333333332e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>8.0000000000000007e-05</iyy>
          <iyz>0</iyz>
          <izz>4.5208333333333332e-05</izz>
        </inertia>
      </inertial>
      <collision name='right_wheel_link_collision'>
        <pose>0 0 0 1.570796326794896 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.025000000000000001</length>
            <radius>0.040000000000000001</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name='right_wheel_link_visual'>
        <pose>0 0 0 1.570796326794896 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>package://forklift_gazebo/models/mini_forklift/meshes/wheel.stl</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Black</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
          <diffuse>0 0 0 1</diffuse>
          <ambient>0 0 0 1</ambient>
        </material>
      </visual>
      <mu>5.0</mu>
    </link>

    <plugin name='ignition::gazebo::systems::JointStatePublisher' filename='libignition-gazebo-joint-state-publisher-system.so'>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <joint_name>lift_joint</joint_name>
      <topic_name>$(arg namespace)/joint_states</topic_name>
      <update_rate>50</update_rate>
    </plugin>
    <plugin name='ignition::gazebo::systems::DiffDrive' filename='libignition-gazebo-diff-drive-system.so'>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.3</wheel_separation>
      <!-- FIXED: was 0.05, now matches the wheel collision cylinder's
           actual radius (0.04) so odometry/commanded speed match the
           real physical geometry. -->
      <wheel_radius>0.04</wheel_radius>
      <update_rate>50</update_rate>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <max_wheel_torque>40</max_wheel_torque>
      <odom_publish_frequency>50</odom_publish_frequency>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <topic>$(arg namespace)/cmd_vel</topic>
      <odom_frame_id>odom</odom_frame_id>
      <robot_base_frame_id>base_footprint</robot_base_frame_id>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
    <plugin name='ignition::gazebo::systems::JointPositionController' filename='libignition-gazebo-joint-position-controller-system.so'>
      <joint_name>lift_joint</joint_name>
      <p_gain>1000.0</p_gain>
      <i_gain>0.2</i_gain>
      <d_gain>0.01</d_gain>
      <i_max>20</i_max>
      <i_min>-20</i_min>
      <cmd_max>1500</cmd_max>
      <cmd_min>-1500</cmd_min>
      <topic>$(arg namespace)/lift_cmd</topic>
    </plugin>
    <plugin name='ignition::gazebo::systems::OdometryPublisher' filename='libignition-gazebo-odometry-publisher-system.so'>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>$(arg namespace)/odom</odom_topic>
      <tf_topic>$(arg namespace)/tf</tf_topic>
      <dimensions>2</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </model>
</sdf>