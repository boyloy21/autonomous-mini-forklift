    <!-- <plugin name='ignition::gazebo::systems::Sensors' filename='libignition-gazebo-sensors-system.so'>
      <render_engine>ogre2</render_engine>
    </plugin> -->
    <!-- <plugin name='ignition::gazebo::systems::Imu' filename='libignition-gazebo-imu-system.so'/> -->
    <!-- <plugin name='ignition::gazebo::systems::SceneBroadcaster' filename='libignition-gazebo-scene-broadcaster-system.so'/> -->
    <plugin name='ignition::gazebo::systems::JointStatePublisher' filename='libignition-gazebo-joint-state-publisher-system.so'>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <joint_name>lift_joint</joint_name>
      <topic_name>$(arg namespace)/joint_states</topic_name>
      <update_rate>50</update_rate>
    </plugin>
    <!-- <plugin name='ign_ros2_control::IgnitionROS2ControlPlugin' filename='libign_ros2_control-system.so'>
      <parameters>/home/yunboyloy/miniforklift_ws/install/forklift_gazebo/share/forklift_gazebo/config/forklift_controllers.yaml</parameters>
      <ros>
        <namespace>$(arg namespace)</namespace>
      </ros>
    </plugin> -->
    <plugin name='ignition::gazebo::systems::DiffDrive' filename='libignition-gazebo-diff-drive-system.so'>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.3</wheel_separation>
      <wheel_radius>0.04</wheel_radius>
      <update_rate>50</update_rate>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <max_wheel_torque>2000</max_wheel_torque>
      <odom_publish_frequency>50</odom_publish_frequency>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <topic>$(arg namespace)/cmd_vel</topic>
      <odom_frame_id>odom</odom_frame_id>
      <robot_base_frame_id>base_footprint</robot_base_frame_id>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
    <plugin name='ignition::gazebo::systems::JointPositionController' filename='libignition-gazebo-joint-position-controller-system.so'>
      <joint_name>lift_joint</joint_name>
      <p_gain>500.0</p_gain>
      <i_gain>0.05</i_gain>
      <d_gain>20.0</d_gain>
      <i_max>20</i_max>
      <i_min>-20</i_min>
      <cmd_max>500</cmd_max>
      <cmd_min>-500</cmd_min>
      <topic>$(arg namespace)/lift_cmd</topic>
    </plugin>
    <plugin name='ignition::gazebo::systems::OdometryPublisher' filename='libignition-gazebo-odometry-publisher-system.so'>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>$(arg namespace)/odom</odom_topic>
      <tf_topic>$(arg namespace)/tf</tf_topic>
      <dimensions>2</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <frame name='caster_joint' attached_to='base_link'>
      <pose>-0.06 0 -0.01 0 -0 0</pose>
    </frame>
    <frame name='front_caster' attached_to='caster_joint'/>
    <frame name='imu_joint' attached_to='base_link'>
      <pose>0 0 0.09 0 -0 0</pose>
    </frame>
    <frame name='imu_link' attached_to='imu_joint'/>
    <frame name='lidar_joint' attached_to='base_link'>
      <pose>-0.01 0 0.17 0 -0 0</pose>
    </frame>
    <frame name='lidar_link' attached_to='lidar_joint'/>
    <frame name='base_joint' attached_to='base_footprint'>
      <pose>0 0 0.04 0 -0 0</pose>
    </frame>
    <frame name='base_link' attached_to='base_joint'/>
    <frame name='camera_joint' attached_to='lift_link'>
      <pose>-0.01 0 0 0 0.349066 0</pose>
    </frame>
    <frame name='camera_link' attached_to='camera_joint'/>
  </model>
</sdf>