<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>forklift_docking</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="yunboyloy@aifarm.com">yunboyloy</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- <buildtool_depend>rosidl_default_generators</buildtool_depend> -->

  <depend>opennav_docking</depend>
  <depend>opennav_docking_core</depend>
  <depend>opennav_docking_bt</depend>
 
  <!-- Nav2 lifecycle management for the docking_server node -->
  <depend>nav2_lifecycle_manager</depend>
  <depend>nav2_common</depend>
  <depend>nav2_msgs</depend>
 
  <!-- Standard ROS2 messaging / TF -->
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_components</depend>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <!-- Gazebo contact messages: charger pad contact for rear charging -->
  <depend>ros_gz_interfaces</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>yaml_cpp_vendor</depend>
 
  <!-- Launch -->
  <depend>launch</depend>
  <depend>launch_ros</depend>

  <!-- <exec_depend>rclpy</exec_depend> -->
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>opennav_docking_msgs</exec_depend>

  <!-- <exec_depend>rosidl_default_generators</exec_depend> -->
  <exec_depend>forklift_aruco</exec_depend>
  <exec_depend>forklift_interfaces</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
