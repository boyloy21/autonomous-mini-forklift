<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="PI" value="3.141592653589793"/>

    <xacro:property name="base_length" value="0.245"/>
    <xacro:property name="base_width" value="0.2426"/>
    <xacro:property name="base_height" value="0.18"/>

    <!-- Mounting bolt pattern on base plate (from drawing sheet 2) -->
    <xacro:property name="base_bolt_pattern_x" value="0.150"/>
    <xacro:property name="base_bolt_pattern_y" value="0.110"/>
    <xacro:property name="base_bolt_hole_dia" value="0.020"/>
    <xacro:property name="base_plate_thickness" value="0.005"/>

    <!-- Kinematics -->
    <xacro:property name="wheel_radius" value="0.040"/>
    <xacro:property name="wheel_width" value="0.025"/>
    <xacro:property name="wheel_zoff" value="0.01"/>
    <xacro:property name="wheel_ygap" value="0.03"/>
    <xacro:property name="wheel_xoff" value="0.1"/>
    <xacro:property name="wheel_separation" value="0.3"/>

    <xacro:property name="caster_radius" value="0.03"/>
    <xacro:property name="caster_xoff" value="0.06"/>
    <xacro:property name="caster_yoff" value="0.0"/>

    <!-- ................................ LIFT SYSTEM ................................ -->
    <!-- Prismatic mast + forks riding on the front of base_link. -->
    <!-- lift_travel is a placeholder (150 mm stroke); set it to your actual mast stroke. -->
    <xacro:property name="lift_travel" value="0.15"/>
    <xacro:property name="lift_lower_limit" value="0.0"/>
    <xacro:property name="lift_upper_limit" value="${lift_travel}"/>
    <xacro:property name="lift_velocity" value="0.10"/>
    <xacro:property name="lift_effort" value="500"/>

    <!-- Where the lift joint mounts on base_link -->
    <xacro:property name="lift_xoff" value="${base_length/2}"/>
    <xacro:property name="lift_yoff" value="0.0"/>
    <xacro:property name="lift_zoff" value="${0}"/>

    <!-- Fork geometry (fork.stl) -->
    <xacro:property name="fork_length" value="0.30"/>
    <xacro:property name="fork_width" value="0.2426"/>
    <xacro:property name="fork_height" value="0.03"/>
    <xacro:property name="fork_xoff" value="0.10"/>

    <xacro:property name="mass_lift" value="1.0"/>
    <xacro:property name="mass_fork" value="0.5"/>

    <!-- Sensor -->
    <xacro:property name="imu_height" value="0.05"/>
    <xacro:property name="imu_offset" value="0.0"/>

    <xacro:property name="two_d_lidar_min_range" value="0.2"/>
    <xacro:property name="two_d_lidar_max_range" value="7"/>
    <xacro:property name="two_d_lidar_update_rate" value="30"/>

    <xacro:property name="lidar_length" value="0.045"/>
    <xacro:property name="lidar_radius" value="0.045"/>
    <xacro:property name="lidar_min_angle" value="0"/>
    <xacro:property name="lidar_max_angle" value="360"/>

    <xacro:property name="lidar_frame_id" value="lidar_link"/>
    <xacro:property name="camera_frame_id" value="camera_link"/>

    <xacro:property name="camera_width" value="0.022"/>
    <xacro:property name="camera_length" value="0.022"/>
    <xacro:property name="camera_height" value="0.022"/>

    <xacro:property name="ultrasonic_radius" value="0.02"/>
    <xacro:property name="ultrasonic_length" value="0.025"/>

    <!-- Define inertial properties  -->
    <xacro:property name="mass_base" value="3.0"/>
    <xacro:property name="mass_wheel" value="0.1"/>
    <xacro:property name="mass_caster" value="0.2"/>
    <xacro:property name="mass_imu" value="0.01"/>
    <xacro:property name="mass_lidar" value="0.150"/>
    <xacro:property name="mass_camera" value="0.050"/>

</robot>